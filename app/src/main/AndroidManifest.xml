<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.windhike.tuto">

    <application
        android:name=".TutoApplication"
        android:allowBackup="true"
        tools:replace="android:icon"
        android:icon="@mipmap/ic_tuto"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_round_tuto_xxx"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".AnnotationPicturesActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--<activity android:name=".AnnotationRecordsActivity" />-->
        <!--<activity android:name=".AnnotationPicturesActivity" />-->
        <activity android:name=".AnnotationProjectEditActivity" />
        <activity android:name=".AnnotationRecentActivity" />
        <activity
            android:name=".AnnotationTextEditActivity"
            android:windowSoftInputMode="stateAlwaysVisible|adjustPan" />
        <activity android:name=".AnnotationPreviewActivity" />
    </application>

</manifest>