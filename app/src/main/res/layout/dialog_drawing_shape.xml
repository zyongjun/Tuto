<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_shape_setting"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/draw_color_frame"
    android:fitsSystemWindows="true"
    android:layout_gravity="center"
    android:paddingTop="@dimen/d_20"
    android:paddingBottom="@dimen/d_20"
    android:layout_marginLeft="@dimen/d_10"
    android:layout_marginRight="@dimen/d_10"
    android:gravity="center"
    android:orientation="vertical">
    <LinearLayout 
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/d_21"
        android:paddingRight="@dimen/d_21"
        android:orientation="horizontal" >
        <ImageView
            android:id="@+id/ivPen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_pen_draw"/>
        <android.support.v4.widget.Space
            android:layout_width="@dimen/dimen_10dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/ivRectange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_rectange_draw"/>
        <android.support.v4.widget.Space
            android:layout_width="@dimen/dimen_10dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/ivCircle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_circle_draw"/>
    </LinearLayout>

    <!--row2-->
    <LinearLayout
        android:id="@+id/linearPage"
        android:layout_marginTop="@dimen/d_10"
        android:paddingLeft="@dimen/d_21"
        android:paddingRight="@dimen/d_21"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal" >
        <ImageView
            android:id="@+id/ivArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_arrow_draw"/>
        <android.support.v4.widget.Space
            android:layout_width="@dimen/dimen_10dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/ivEraser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_eraser_draw"/>
        <android.support.v4.widget.Space
            android:layout_width="@dimen/dimen_10dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/ivMask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_mask_draw"/>
    </LinearLayout>

    <!--row3-->
    <LinearLayout
        android:layout_marginTop="@dimen/d_21"
        android:paddingLeft="@dimen/d_23"
        android:paddingRight="@dimen/d_23"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal" >
        <TextView
            android:id="@+id/ivColorOne"
            android:layout_width="@dimen/d_34"
            android:layout_height="@dimen/d_34"
            android:background="@drawable/ic_anno_color_one_unselected"/>
        <android.support.v4.widget.Space
            android:layout_width="@dimen/dimen_10dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/ivColorSecond"
            android:layout_width="@dimen/d_34"
            android:layout_height="@dimen/d_34"
            android:background="@drawable/ic_anno_color_two_unselected"/>
        <android.support.v4.widget.Space
            android:layout_width="@dimen/dimen_10dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/ivColorThird"
            android:layout_width="@dimen/d_34"
            android:layout_height="@dimen/d_34"
            android:background="@drawable/ic_anno_color_three_unselected"/>
    </LinearLayout>

    <!--row4-->
    <LinearLayout
        android:layout_marginTop="@dimen/d_23"
        android:paddingLeft="@dimen/d_23"
        android:paddingRight="@dimen/d_23"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal" >
        <TextView
            android:id="@+id/ivColorFour"
            android:layout_width="@dimen/d_34"
            android:layout_height="@dimen/d_34"
            android:background="@drawable/ic_anno_color_four_unselected"/>
        <android.support.v4.widget.Space
            android:layout_width="@dimen/dimen_10dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/ivColorFive"
            android:layout_width="@dimen/d_34"
            android:layout_height="@dimen/d_34"
            android:background="@drawable/ic_anno_color_five_unselected"/>
        <android.support.v4.widget.Space
            android:layout_width="@dimen/dimen_10dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:id="@+id/ivColorSix"
            android:layout_width="@dimen/d_34"
            android:layout_height="@dimen/d_34"
            android:background="@drawable/ic_anno_color_six_unselected"/>
    </LinearLayout>
</LinearLayout>